parameters:
    level: 8
    paths:
        - src
        - tests
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
    ignoreErrors:
        # Entity-властивості типізовані як ?T = null (патерн ідентичності Doctrine до persist),
        # хоча колонки NOT NULL — це свідомо, інваріант забезпечують контролери й БД.
        - identifier: doctrine.associationType
        - identifier: doctrine.columnType
